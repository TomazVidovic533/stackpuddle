{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stackpuddle:schema:v1:manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "bundleVersion", "modules"],
  "properties": {
    "apiVersion": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/apiVersion" },
    "kind": { "type": "string", "const": "Manifest" },
    "bundleVersion": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/semanticVersion" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/moduleName" }
    }
  }
}
