{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stackpuddle:schema:v1:module",
  "description": "A Module Definition: one independently versioned capability, its compatibility needs and its content files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "name", "version"],
  "properties": {
    "apiVersion": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/apiVersion" },
    "kind": { "type": "string", "const": "Module" },
    "name": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/moduleName" },
    "version": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/semanticVersion" },
    "dataFormat": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/dataFormat" },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities"],
      "properties": {
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/capability" }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": {
        "schema": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/contentPath" },
        "defaults": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/contentPath" }
      }
    },
    "runtimes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/contentPath" },
            "hostAccessFile": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/contentPath" }
          }
        }
      }
    },
    "provisioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract"],
      "properties": { "contract": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/contentPath" } }
    },
    "workloads": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/objectKey" },
      "additionalProperties": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/workloadDeclaration" }
    }
  }
}
