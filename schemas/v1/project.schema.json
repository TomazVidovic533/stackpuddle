{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stackpuddle:schema:v1:project",
  "description": "A StackPuddle project root: the declarations of one project and the Fragment files it imports.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/apiVersion" },
    "kind": { "type": "string", "const": "Project" },
    "metadata": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/projectMetadata" },
    "spec": {
      "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/sections",
      "properties": {
        "imports": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/relativePath" }
        },
        "manifest": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/relativePath" },
        "lock": { "$ref": "urn:stackpuddle:schema:v1:definitions#/$defs/relativePath" }
      },
      "unevaluatedProperties": false
    }
  }
}
