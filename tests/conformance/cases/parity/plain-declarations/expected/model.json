  "spec": {
    "environments": {
      "local": {
        "runtime": {
          "context": "desktop-linux",
          "type": "compose"
        },
        "secrets": {
          "provider": "local"
        }
      }
    },
    "objects": [
      {
        "apiVersion": "stackpuddle/v1",
        "key": "primary",
        "kind": "ModuleInstance",
        "spec": {
          "definition": "postgres",
          "options": {
            "databases": {
              "shop": {
                "connectRoles": [
                  "writer"
                ],
                "owner": "migrator",
                "schemas": {
                  "public": {
                    "grants": {
                      "writer": {
                        "sequences": [
                          "USAGE"
                        ],
                        "tables": [
                          "SELECT",
                          "INSERT"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "roles": {
              "writer": {
                "login": false
              }
            },
            "users": {
              "app": {
                "memberOf": [
                  "writer"
                ],
                "passwordSecretRef": "app-password",
                "purpose": "runtime"
              },
              "migrator": {
                "passwordSecretRef": "migrator-password",
                "purpose": "migrations"
              }
            }
          }
        }
      },
      {
        "apiVersion": "stackpuddle/v1",
        "key": "api",
        "kind": "Workload",
        "spec": {
          "environment": {
            "LOG_LEVEL": "info"
          },
          "image": "ghcr.io/example/api:1.4.2",
          "listeners": {
            "http": {
              "port": 8080,
              "protocol": "http"
            }
          },
          "type": "service"
        }
      }
    ]
  }
