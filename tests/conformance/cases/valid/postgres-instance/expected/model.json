{
  "apiVersion": "stackpuddle/v1",
  "kind": "Model",
  "metadata": {
    "name": "catalog"
  },
  "provenance": {
    "env/local": {
      "declared": {
        "column": 5,
        "file": "stackpuddle.yaml",
        "line": 34,
        "origin": "yaml"
